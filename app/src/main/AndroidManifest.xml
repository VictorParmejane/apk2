<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.vigilancia">

    <!-- 🔹 Permissões necessárias -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 🔹 ForegroundService com uso de microfone -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_vigilancia"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_vigilancia_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 🔹 Suas telas -->
        <activity
            android:name=".WebViewPG"
            android:exported="false" />

        <activity
            android:name=".Table"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔹 Serviço global de voz -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>