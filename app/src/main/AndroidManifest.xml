<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.vigilancia">

    <!-- Permissões -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/> <!-- ESSENCIAL PARA ABRIR O APP POR VOZ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_vigilancia"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_vigilancia_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Activity do WebView -->
        <activity android:name=".WebViewPG" android:exported="false" />

        <!-- Activity TABLE agora é a PRINCIPAL (Launcher) -->
        <activity
            android:name=".Table"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Se MainActivity não for usada, pode remover ou deixar sem intent-filter -->
        <activity android:name=".MainActivity" android:exported="false" />

        <service android:name=".VoiceService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>