<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Principal -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Remove qualquer barra nativa antiga -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Cores Sólidas -->
        <item name="colorPrimary">#0d6efd</item>
        <item name="colorPrimaryDark">#0d6efd</item> <!-- Mesma cor para não ter degrader -->
        <item name="colorAccent">#0d6efd</item>

        <!-- Barra de Status (Onde fica a bateria) -->
        <item name="android:statusBarColor">#0d6efd</item>
        <item name="android:windowLightStatusBar">false</item> <!-- Ícones brancos -->

        <!-- Evita que o layout "pule" para baixo criando espaço branco -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>