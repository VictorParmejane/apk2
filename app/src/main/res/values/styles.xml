<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Azul sem Barra de Título Branca -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- NÃO use Fullscreen=true, senão a barra azul some. -->
        <item name="android:windowFullscreen">false</item>

        <!-- Define a cor da barra de status (Bateria/Relógio) para o seu Azul -->
        <item name="android:statusBarColor">#0d6efd</item>

        <!-- Define a cor dos ícones da barra (branco para contrastar com azul) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>